{
    "source": {
      "include": ["src"],
      "exclude": ["node_modules", "docs", "tests"],
      "includePattern": ".+\\.js$"
    },
    "opts": {
      "destination": "./docs/jsdoc",
      "recurse": true,
      "encoding": "utf8"
    },
    "plugins": ["plugins/markdown"],
    "templates": {
      "default": {
        "outputSourceFiles": true
      }
    }
  }